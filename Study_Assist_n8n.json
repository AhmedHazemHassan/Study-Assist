    {
      "parameters": {
        "functionCode": "function getFirstItem(nodeName) {\n  try {\n    const arr = $items(nodeName);\n    if (!arr || !Array.isArray(arr) || arr.length === 0) return null;\n    return arr[0];\n  } catch (e) {\n    return null;\n  }\n}\n\n// Summary from Parse Summary\nconst summaryItem = getFirstItem('Save Validated Summary');\nconst summary = summaryItem?.json?.summary || '';\n\n// Quiz output (if Quiz Agent ran)\nconst quizItem = getFirstItem('Quiz Agent');\nconst quizRaw = quizItem?.json?.output;\n\n// Flashcard output (if Flashcard Agent ran)\nconst flashItem = getFirstItem('Flashcard Agent');\nconst flashRaw = flashItem?.json?.output;\n\nlet quiz = null;\nlet flashcards = null;\n\n// Parse quiz JSON\nif (quizRaw) {\n  try {\n    quiz = JSON.parse(quizRaw);\n  } catch (e) {\n    quiz = { error: 'Quiz JSON parse failed', raw: quizRaw };\n  }\n}\n\n// Parse flashcards JSON\nif (flashRaw) {\n  try {\n    flashcards = JSON.parse(flashRaw);\n  } catch (e) {\n    flashcards = { error: 'Flashcard JSON parse failed', raw: flashRaw };\n  }\n}\n\nreturn [\n  {\n    json: {\n      summary,\n      quiz,\n      flashcards,\n    },\n  },\n];"
      },
      "id": "3225321d-7881-41bc-aad2-bd5d0355bf8f",

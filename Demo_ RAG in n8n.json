      "id": "e67158d5-d591-4cdf-8417-9ddcec23de4b",
      "name": "Compose Final Report (Function)",
      "functionCode": "const validated_summary = $items('save-validated-summary-set')[0]?.json?.validated_summary || '';\nconst key_points = $items('save-validated-summary-set')[0]?.json?.validated_key_points ? JSON.parse($items('save-validated-summary-set')[0].json.validated_key_points) : [];\nconst quizzes = $items('quiz-agent').map(i => i.json).filter(Boolean);\nconst flashcards = $items('flashcard-agent').map(i => i.json).filter(Boolean);\nconst answers = $items('answer-gen-agent').map(i=>i.json).filter(Boolean);\nconst report = { summary: validated_summary, key_points, quizzes, flashcards, answers, generated_at: new Date().toISOString() };\nconst reportStr = JSON.stringify(report, null, 2);\nconst b64 = Buffer.from(reportStr).toString('base64');\nreturn [{json: report, binary: { reportFile: { data: b64, fileName: 'studyassist_report.json', mimeType: 'application/json' }}}];"

      "name": "Create Memory Binary (Function)",
      "functionCode": "const validated_summary = $json[\"validated_summary\"] || $items(\"save-validated-summary-set\")[0]?.json?.validated_summary || '';\nconst key_points = $json[\"validated_key_points\"] ? JSON.parse($json[\"validated_key_points\"]) : ($items(\"save-validated-summary-set\")[0]?.json?.validated_key_points ? JSON.parse($items(\"save-validated-summary-set\")[0].json.validated_key_points) : []);\nconst memory = { validated_summary, key_points, timestamp: new Date().toISOString() };\nconst dataStr = JSON.stringify(memory, null, 2);\nconst b64 = Buffer.from(dataStr).toString('base64');\nreturn [{json: {fileName: 'studyassist_memory.json', mimeType: 'application/json'}, binary: {data: {data: b64, fileName: 'studyassist_memory.json', mimeType: 'application/json'}}}];"
